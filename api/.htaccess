Options -Indexes

# Shared helpers and retired handlers must never be requested directly.
<FilesMatch "^(config|test|send-telegram|get-start-date-simple)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

